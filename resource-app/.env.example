# Copy this file to .env.local and replace the example values.
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:1234567890:web:replace_with_your_app_id

# Optional Firebase values. Leave blank until the feature is configured.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check -> reCAPTCHA Enterprise site key.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Choose a Gemini Developer API model that is available on your project's
# free tier. Verify the current model and quota in Google AI Studio first.
VITE_GEMINI_MODEL=gemini-2.5-flash

# Keep false until Firebase AI Logic, App Check, and quota handling are ready.
VITE_ENABLE_LIVE_AI=false

# Do not add a Gemini API key to this client-side Vite application.
# We will use Firebase AI Logic and App Check for browser access.
